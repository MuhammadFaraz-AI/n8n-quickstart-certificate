      "name": "Europe Only"
    },
    {
      "parameters": {
        "jsCode": "// 1. Initialize the total variable\nlet totalPrice = 0;\n\n// 2. Loop through all incoming rows/items\nfor (const item of $input.all()) {\n  // Extract the price field and convert it to a number\n  const priceValue = parseFloat(item.json.orderTotal);\n\n  // Add to total if it is a valid number\n  if (!isNaN(priceValue)) {\n    totalPrice += priceValue;\n  }\n}\n\n// 3. Return the single final total object\nreturn [{ total_price: totalPrice }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1424, 0],
